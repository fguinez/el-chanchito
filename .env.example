# PostgreSQL
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
DATABASE_URL=postgres://finance:finance@localhost:5435/finance

# Dashboard authentication (single shared password; see USAGE.md > Deployment).
# Unset in `next dev` ⇒ no login (local convenience). Unset in production ⇒ the
# app fails closed and serves nothing. Stored in the Keychain like the scraper
# secrets (`make secrets-init`), so it is not written here.
#   DASHBOARD_PASSWORD=
# How long a session lasts before the password is asked again. Accepts a
# duration (30m, 12h, 7d, 30d), a bare number of seconds, "browser" (re-login on
# every new browser session) or "unlimited". Default when unset: 12h.
#   DASHBOARD_SESSION_MAX_AGE=12h

# Scraper identifiers (non-secret).
# Secrets (BANCHILE_PASSWORD, LIDER_BCI_PASSWORD, FINTUAL_PASSWORD, BUDA_API_KEY,
# BUDA_API_SECRET, EMAIL_IMAP_PASSWORD) are NOT stored here; they live in the
# macOS Keychain:
#   make secrets-init      # store them interactively
#   make secrets-status    # check what's stored
# On non-macOS (e.g. Docker-only deploys) export them as env vars instead.
BANCHILE_RUT=
LIDER_BCI_RUT=
# Tarjeta Lider Bci scrapes by driving a real Chrome (its login is behind a
# Cloudflare check only a genuine browser clears). By default it runs "managed":
# each scrape launches Chrome, logs in, and closes it (needs a machine with a
# display, not the headless container). To instead reuse a long-running Chrome you
# started with `make bci-lider-login`, set:
#   LIDER_BCI_CDP_URL=http://localhost:9222
FINTUAL_EMAIL=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_USER=

# On-demand refresh from the dashboard (internal control endpoint; optional).
# Docker Compose sets sane defaults; only override for host-dev. See USAGE.md.
#   SCRAPER_CONTROL_PORT=8080                 # scraper service: enable + bind
#   SCRAPER_CONTROL_URL=http://localhost:8080 # dashboard: where to reach it
