# PostgreSQL
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
DATABASE_URL=postgres://finance:finance@localhost:5435/finance
# Host port Docker Compose publishes Postgres on (default 5435), always on
# 127.0.0.1 only: the default password is public, so no other machine may reach
# it. The make targets and scripts/dev.sh take DATABASE_URL from your shell, not
# from this file (default port 5435), so if you change it, also export a
# matching DATABASE_URL.
#   POSTGRES_PORT=5435

# Dashboard authentication (single shared password; see USAGE.md > Deployment).
# Unset in `next dev` ⇒ no login (local convenience). Unset in production ⇒ the
# app fails closed and serves nothing. Stored in the Keychain like the scraper
# secrets (`make secrets-init`), so it is not written here.
#   DASHBOARD_PASSWORD=
# How long a session lasts before the password is asked again. Accepts a
# duration (30m, 12h, 7d, 30d), a bare number of seconds, "browser" (re-login on
# every new browser session) or "unlimited". Default when unset: 12h.
#   DASHBOARD_SESSION_MAX_AGE=12h
# Address the dashboard listens on (port 3000). Default 127.0.0.1: only this
# machine can open it. Set 0.0.0.0 (or a LAN/VPN interface address) to open it
# from another device such as your phone. Compose needs an IPv4 address or a
# bracketed IPv6 one ([::]). `make up` reads it from this file; `make dev` and
# `make dev-web` read it from your shell and refuse a non-loopback value unless
# DASHBOARD_PASSWORD is also exported there (`next dev` reads neither this file
# nor the Keychain):
#   DASHBOARD_PASSWORD='...' DASHBOARD_HOST=0.0.0.0 make dev
# See USAGE.md > Reaching the dashboard from another device.
#   DASHBOARD_HOST=127.0.0.1
# Hot reload under `make dev` from another device: the hostnames it uses to
# open the dashboard (comma-separated), e.g. your LAN or Tailscale IP.
#   DASHBOARD_DEV_ORIGINS=192.168.0.10
# Set only when a reverse proxy in front rewrites the X-Forwarded-* headers (it
# must overwrite them, not pass a client's through). Unset means they are ignored
# entirely: any caller can send them. See USAGE.md > Behind a reverse proxy.
#   DASHBOARD_TRUST_PROXY=1

# Scraper identifiers (non-secret).
# Secrets (BANCHILE_PASSWORD, LIDER_BCI_PASSWORD, FINTUAL_PASSWORD, BUDA_API_KEY,
# BUDA_API_SECRET, EMAIL_IMAP_PASSWORD) are NOT stored here; they live in the
# macOS Keychain:
#   make secrets-init      # store them interactively
#   make secrets-status    # check what's stored
# On non-macOS (e.g. Docker-only deploys) export them as env vars instead.
# FINTUAL_TOKEN is still read as a legacy name for FINTUAL_PASSWORD.
BANCHILE_RUT=
# The Banco de Chile web session is cached between runs so a full RUT + password
# login only happens when it expires (the bank throttles repeated logins). The
# file is a secret (written 0600, gitignored). Optional; defaults to
# apps/scrapers/.banchile_session.json (Compose: /data/banchile_session.json):
#   BANCHILE_SESSION_FILE=/absolute/path/to/banchile_session.json
# At most one full BanChile login per this many minutes, whatever triggers the
# run; a manual refresh that would need a second one sooner is refused, one the
# cached session can serve is not. Optional; default 10, 0 disables:
#   BANCHILE_LOGIN_COOLDOWN_MINUTES=10
LIDER_BCI_RUT=
# Tarjeta Lider Bci scrapes by driving a real Chrome (its login is behind a
# Cloudflare check only a genuine browser clears). By default it runs "managed":
# each scrape launches Chrome, logs in, and closes it (needs a machine with a
# display, not the headless container). To instead reuse a long-running Chrome you
# started with `make bci-lider-login`, set:
#   LIDER_BCI_CDP_URL=http://localhost:9222
# Debug port the managed Chrome and `make bci-lider-login` use (default 9222),
# and the Chrome binary when it isn't in a standard location:
#   LIDER_BCI_CDP_PORT=9222
#   LIDER_BCI_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
FINTUAL_EMAIL=
# Where `make fintual-login` caches the Fintual web session. Default:
# apps/scrapers/.fintual_session.json (gitignored); Docker Compose sets
# /data/fintual_session.json on the scraper_state volume.
#   FINTUAL_SESSION_FILE=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_USER=
# Optional email parser tuning (defaults shown). Use Gmail's All Mail
# ("[Gmail]/All Mail", or "[Gmail]/Todos" with a Spanish UI) when filters
# archive the notifications.
#   EMAIL_LOOKBACK_DAYS=7
#   EMAIL_MAX_MESSAGES=100
#   EMAIL_IMAP_MAILBOX=INBOX

# Scraper service mode: "scheduled" (default; long-running APScheduler loop) or
# "once" (run every enabled scraper once and exit). `make scrapers-once` and
# `make scrapers-start` set it for you.
#   SCRAPER_MODE=scheduled

# On-demand refresh from the dashboard (internal control endpoint; optional).
# Docker Compose sets sane defaults; only override for host-dev. See USAGE.md.
# The endpoint is an unauthenticated trigger, so outside Compose it listens on
# loopback only (Compose sets 0.0.0.0 inside the container, never published).
#   SCRAPER_CONTROL_PORT=8080                 # scraper service: enable + bind
#   SCRAPER_CONTROL_HOST=127.0.0.1            # scraper service: bind address
#   SCRAPER_CONTROL_URL=http://127.0.0.1:8080 # dashboard: where to reach it
