# The scraper service's private key for the credentials sealed in the DB.
.credentials_key
.credentials_key.*
# Per-institution browser profiles (live sessions), e.g. .bci_lider_chrome_profile/
.*_chrome_profile*/
# Left next to a profile when its session is lost, e.g. .mercadopago_chrome_profile.needs-sign-in
*.needs-sign-in
# Ties a profile to its account (a salted hash), e.g. .bci_lider_chrome_profile.account
.*_chrome_profile.account
.agents/*local*
**/.claude/*
!/.claude/skills/
.gemini/
.cursor/
.lavish/