{
  "$defs": {
    "CheckingAttributes": {
      "additionalProperties": false,
      "description": "Identity fields for a checking account (cuenta corriente).",
      "properties": {
        "account_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Account number as shown by the institution.",
          "title": "Account Number"
        },
        "kind": {
          "const": "checking",
          "default": "checking",
          "description": "Payload discriminator; always \"checking\".",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "CheckingAttributes",
      "type": "object"
    },
    "CheckingMetrics": {
      "additionalProperties": false,
      "description": "Observation for a checking account; headline is `balance`.",
      "properties": {
        "accounting_balance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "denomination": "currency",
          "description": "Accounting balance in account currency (Saldo contable).",
          "title": "Accounting Balance"
        },
        "balance": {
          "denomination": "currency",
          "description": "Available balance in account currency (Saldo disponible).",
          "title": "Balance",
          "type": "number"
        },
        "kind": {
          "const": "checking",
          "default": "checking",
          "description": "Payload discriminator; always \"checking\".",
          "title": "Kind",
          "type": "string"
        },
        "reported_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date the institution printed next to the balance.",
          "title": "Reported As Of"
        }
      },
      "required": [
        "balance"
      ],
      "title": "CheckingMetrics",
      "type": "object"
    },
    "CreditCardAttributes": {
      "additionalProperties": false,
      "description": "Identity/config fields for a credit card.",
      "properties": {
        "brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Card network or product brand (e.g. 'Visa Signature').",
          "title": "Brand"
        },
        "due_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Day of month the payment is due (vencimiento).",
          "title": "Due Day"
        },
        "kind": {
          "const": "credit_card",
          "default": "credit_card",
          "description": "Payload discriminator; always \"credit_card\".",
          "title": "Kind",
          "type": "string"
        },
        "last4": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last four digits of the card number (from the masked '****0000').",
          "title": "Last4"
        },
        "statement_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Day of month the statement closes (facturación).",
          "title": "Statement Day"
        }
      },
      "title": "CreditCardAttributes",
      "type": "object"
    },
    "CreditCardMetrics": {
      "additionalProperties": false,
      "description": "Observation for a credit card; headline is `available`.",
      "properties": {
        "available": {
          "denomination": "currency",
          "description": "Available credit in product currency (Disponible).",
          "title": "Available",
          "type": "number"
        },
        "kind": {
          "const": "credit_card",
          "default": "credit_card",
          "description": "Payload discriminator; always \"credit_card\".",
          "title": "Kind",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "denomination": "currency",
          "description": "Total credit limit in product currency (Cupo total).",
          "title": "Limit"
        },
        "owed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "denomination": "currency",
          "description": "Amount drawn as reported by the bank (Utilizado / Monto utilizado).",
          "title": "Owed"
        },
        "reported_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date the institution printed next to the card figures.",
          "title": "Reported As Of"
        }
      },
      "required": [
        "available"
      ],
      "title": "CreditCardMetrics",
      "type": "object"
    },
